[Unit]
Description=Biandan schedule API (biandan-api)
After=network.target

[Service]
Type=simple
User=biandan-api
Group=biandan-api
Environment=BIANDAN_API_LISTEN=127.0.0.1:18730
Environment=BIANDAN_API_KEYS=/etc/biandan-api/keys
Environment=BIANDAN_API_DATA=/var/lib/biandan-api
ExecStart=/usr/local/bin/biandan-api serve
# 重新读取密钥文件，不中断服务
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

StateDirectory=biandan-api
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
